APP_ENV=dev_demo
APP_DEBUG=false
SEED_DEMO=false
JWT_SECRET=replace-with-at-least-32-random-characters
OWNER_EMAIL=owner@example.org
OWNER_NAME=Владелец платформы
OWNER_PASSWORD=replace-with-a-strong-owner-password
POSTGRES_PASSWORD=replace-with-a-strong-database-password
# Local launch uses backend/reviewer.db unless DATABASE_URL is set.
# DATABASE_URL=postgresql+psycopg://reviewer:password@localhost:5432/reviewer
JOB_MODE=local
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# For debug data and role previews set APP_DEBUG=true and SEED_DEMO=true.
# Public providers only receive explicitly public demo artifacts.
ALLOW_PUBLIC_LLM=true
GEMINI_API_KEY=
GEMMA_MODEL=gemma-4-31b-it
# Optional: only needed for a separately configured OpenAI model.
OPENAI_API_KEY=
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
# Required in pilot_sensitive/production. Comma-separated owner/repository entries.
GITHUB_ALLOWED_REPOSITORIES=
LM_STUDIO_API_KEY=
VLLM_API_KEY=
OLLAMA_API_KEY=
# Private remote endpoints must be allowlisted and declare zero_retention capability.
APPROVED_MODEL_HOSTS=
# ARTIFACT_ROOT=backend/artifacts
# Local inference through LM Studio. Existing model registry: npm run model:local.
LLM_PROVIDER=lm_studio
LM_STUDIO_BASE_URL=http://127.0.0.1:8002/v1
LM_STUDIO_MODEL=openai/gpt-oss-20b
# JPlag runtime is installed inside backend/vendor by npm run setup:jplag.
JPLAG_TIMEOUT_SECONDS=120
